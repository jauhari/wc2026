# Optional: BallDontLie FIFA API key (GOAT tier) — override live score & assist dari FIFA API gratis.
# Free tier BallDontLie hanya tim/stadion. Daftar di https://app.balldontlie.io
BALLDONTLIE_API_KEY=

# URL publik situs (untuk SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://wc2026.ponjong.workers.dev

# Optional: Cloudflare Web Analytics site token (wc2026.ponjong.workers.dev)
# Provision otomatis: npm run setup:cf-analytics
# Manual: Cloudflare Dashboard → Web Analytics → Add site → salin token
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=